<?xml version="1.0" encoding="utf-8"?>
<!--
  @capacitor/camera writes the temp photo file before handing it to the system camera
  app via FileProvider. Different Capacitor/Android versions have used different
  directories for that temp file (app cache dir, app-specific external files dir, etc.).
  If the actual file's path doesn't match one of the roots declared here, FileProvider
  throws "Failed to find configured root..." which the plugin surfaces as the generic
  "Unable to create photo on disk" error. Declaring every standard root (all pointing at
  "." = the whole respective directory tree) removes that whole class of mismatch,
  regardless of which one the installed plugin version actually uses.
-->
<paths xmlns:android="http://schemas.android.com/apk/res/android">
    <cache-path name="cache" path="." />
    <external-cache-path name="external-cache" path="." />
    <files-path name="files" path="." />
    <external-files-path name="external-files" path="." />
    <external-path name="external" path="." />
</paths>
